# ─────────────────────────────────────────────────────────────
# Samik — Environment Variables
# ─────────────────────────────────────────────────────────────
# This .env is used for LOCAL DEVELOPMENT (SQLite).
# For Liara production, set these via the Liara dashboard "Environment
# Variables" section (DO NOT commit a .env.production — use secrets).
# See .env.example for the production template.

# ── Database ──────────────────────────────────────────────────
# Local dev: SQLite file (used by prisma/schema.dev.prisma)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Production (Liara): set DATABASE_URL to the Liara Postgres URL, e.g.
#   DATABASE_URL=postgresql://user:password@postgres-xxx.liara.cloud:30416/samik?schema=public
# And run `bun run db:push:prod` to create the tables.

# ── Auth / JWT ────────────────────────────────────────────────
# Secret used to sign JWT tokens (jose HS256). MUST be at least 32 chars.
# In production, generate with: `openssl rand -hex 32`
JWT_SECRET=samik-dev-secret-change-in-production-min-32-chars-long

# ── SuperAdmin Phone Allowlist ────────────────────────────────
# Comma-separated phone numbers granted the global SUPER_ADMIN role.
# Section 2 of the architecture doc: SuperAdmin is a global role, not
# tied to any school. In production this list should live in a managed
# config table, but for now we use an env allowlist.
SAMIK_SUPER_ADMIN_PHONES=09123456789

# ── SMS Gateway (Arta Payamak) — PHASE 5 Part 2 (pending) ─────
# Currently the SMS sending in `/api/v1/notifications/outbox/send-bulk`
# is SIMULATED (500ms delay per SMS, no real provider call).
# When Arta Payamak is integrated, set these:
#   ARTA_PAYAMAK_API_URL=https://api.artapayamak.com/api/v1/sms/send
#   ARTA_PAYAMAK_API_KEY=<your-api-key>
#   ARTA_PAYAMAK_SENDER_NUMBER=<your-sender-line>
# The code will read these and switch from simulation to real gateway.
# Until set, the system runs in "dev mode" (logs the SMS to console
# instead of sending a real SMS).

# ── Node Environment ──────────────────────────────────────────
# Next.js sets this automatically; only override for explicit control.
NODE_ENV=development
